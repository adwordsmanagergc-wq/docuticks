# Auth.js — required.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Database (Postgres). On Vercel, add the Postgres integration and these
# variables are injected automatically. For local dev, point them at any
# Postgres instance (Neon free tier works well).
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Optional — Google sign-in. Leave blank to hide the "Continue with Google"
# button. Create credentials at https://console.cloud.google.com/apis/credentials.
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
